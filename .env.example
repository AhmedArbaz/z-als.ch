# Copy to .env for local development. .env is gitignored.
# Production values live in Dokploy's environment panel, never in git.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook destination https://z-als.ch/api/stripe/webhook (whsec_…). Blank: the webhook answers 503.
STRIPE_WEBHOOK_SECRET=
SITE_URL=http://localhost:3002
# Resend API key (send access, domain z-als.ch). Without it no email is sent: "Pay the chauffeur" and the contact
# form show an error pointing to WhatsApp or the phone; "Book via WhatsApp" still opens WhatsApp.
RESEND_API_KEY=
NOTIFY_TO=info@z-als.ch
